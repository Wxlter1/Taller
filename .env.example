# Plantilla de variables sensibles. Cópiala como .env (en esta misma carpeta) y completa los valores:
#   Windows:  copy .env.example .env        Linux:  cp .env.example .env
# El backend, los detectores y start_project.sh leen .env automáticamente.
# .env NO se sube al repositorio; este archivo de ejemplo sí (no pongas valores reales aquí).

# --- Cámaras ---
# cameras.json referencia estas variables como ${NOMBRE}. Si una queda vacía, esa cámara
# usa directamente su video de respaldo y no muestra el enlace "Cámara original".
CAMERA_FACE_STREAM_URL="rtsp://IP_DEL_SERVIDOR:PUERTO/share-CODIGO"
CAMERA_FACE_WATCH_URL="http://IP_DEL_SERVIDOR:PUERTO/watch/CODIGO"
CAMERA_AC_STREAM_URL=""
CAMERA_AC_WATCH_URL=""

# --- Dirección de la página (solo servidor Linux, start_project.sh) ---
# Con dominio (recomendado; el dominio debe apuntar a la IP del servidor):
#   SITE_ADDRESS="smartparking.midominio.cl"
#   CADDY_TLS="tu-correo@midominio.cl"      -> certificado gratuito de Let's Encrypt
#
# Solo con IP (mientras no tengas dominio):
#   SITE_ADDRESS="https://200.1.2.3"
#   CADDY_TLS="internal"                    -> cifrado, pero el navegador avisa la primera vez
SITE_ADDRESS="https://200.1.2.3"
CADDY_TLS="internal"

# --- Opcional ---
# Clave compartida backend/detector. Si se deja vacía, el backend la genera en backend/.detector_key.
# DETECTOR_API_KEY=""
